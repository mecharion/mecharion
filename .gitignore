# 构建产物
/bin/
/dist/
*.exe
*.test
*.out

# Pack 打包产物
*.mpack
*.sig

# 本地开发数据
/.local/
/tmp/

# IDE
.idea/
.vscode/
*.iml
*.swp
*~

# AI/IDE 本地工具配置——只对本机有意义，别的协作者 clone 之后用不上
.codex/
.claude/worktrees/
.cursor/
.fleet/

# OS
.DS_Store
Thumbs.db
desktop.ini

# 运行时产物
*.pid
*.log

# 本地密钥/环境变量——examples/packs/ 下用的是 *.env.tmpl 模板，真实 .env
# 不该出现在这里；PKI 相关代码不少（internal/pki、internal/vault），本地
# 证书/私钥也不该被误提交
.env
.env.*
*.pem
*.key

# 依赖（Go modules 不入库；离线构建改用 vendor 时删除此行）
/vendor/

# 前端
/webui/node_modules/
/webui/dist/

# Web UI 的 embed 产物：由 `make webui` 现场构建，不入库（ADR-0036）。
# 只保留 .gitkeep——`//go:embed all:dist` 靠它让空目录也编译得过。
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
# realpack.sh / quickstartpack.sh 的中间产物。**不能放在 bin/ 里**：那个
# 目录会整个同步进测试容器，而同步用的 `cp -f` 不带 -r，一个子目录会让
# 整条链断掉，报出来的却是「bin 是空的」（23-web-ui §6.11 记着这次）。
.realpack-work/
.quickstart-work/

# 覆盖率产物
/webui/coverage/
/coverage.out

# 写到一半的文件。bundle 与上传都先写 .part 再原子改名——
# 中断留下的半个文件与完整的在文件系统上长得一模一样。
*.part
